{
  "name": "lld-practice-platform",
  "version": "1.0.0",
  "description": "Interactive Low-Level System Design Practice & Evaluation Platform",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "server": "tsx src/server/index.ts",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
